# Copy to .env before starting the Docker Compose stack.
POSTGRES_DB=dealroom
POSTGRES_USER=dealroom
POSTGRES_PASSWORD=replace_with_a_local_password
# Used by the API container; `postgres` is its Compose service hostname.
DATABASE_URL=postgres://dealroom:replace_with_a_local_password@postgres:5432/dealroom
# Host-side connection for pgAdmin. Change the password here to match above.
POSTGRES_HOST_PORT=5433
PGADMIN_DATABASE_URL=postgres://dealroom:replace_with_a_local_password@localhost:5433/dealroom
REDIS_URL=redis://redis:6379
PORT=3000
# Local Docker web origin. In Render, replace with the Vercel origin(s),
# comma-separated if you also want to allow a stable preview domain.
FRONTEND_ORIGIN=http://localhost:5173
